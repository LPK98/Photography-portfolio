# Copy this file to .env.local and fill it in. Never commit .env.local.

# Public URL of the deployed site (used for sitemap, social previews, canonical links)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form email delivery via Resend (https://resend.com, free tier is plenty)
RESEND_API_KEY=
# Where enquiries are delivered (defaults to the email in src/config/site.ts)
CONTACT_TO_EMAIL=you@example.com
# Sender address. Use a verified domain in Resend; the default only works for testing.
CONTACT_FROM_EMAIL="Website Enquiries <onboarding@resend.dev>"
